FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies first (leverage Docker cache)
COPY backend/package*.json ./
RUN npm ci

# Copy code and schema
COPY backend/tsconfig.json ./
COPY backend/prisma ./prisma
COPY backend/src ./src

# Generate Prisma client and compile typescript
RUN npx prisma generate
RUN npm run build

# Stage 2: Runtime image
FROM node:20-alpine

WORKDIR /app

COPY backend/package*.json ./
RUN npm ci --only=production

# Copy build artifacts and prisma files
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma/client ./node_modules/@prisma/client
COPY backend/prisma ./prisma

EXPOSE 5000

ENV PORT=5000
ENV NODE_ENV=production
ENV JWT_SECRET=production-secret-aether-erp

# Script to run migrations, seeding, and starting server
CMD npx prisma migrate deploy && npx prisma db seed && node dist/index.js
